# Copy to .env and fill in.

# Dev (SQLite):
DATABASE_URL="file:./dev.db"

# Production (Postgres) — also switch provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/cb_pos?schema=public"

# Used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"
