// CB_POS — Retail point-of-sale
// Dev uses SQLite. To move to Postgres: set provider = "postgresql",
// point DATABASE_URL at your Postgres instance, then `npx prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The operating company. A single row, id = "company". Its details appear on
/// receipts and invoices; individual locations live in Store.
model Company {
  id        String   @id @default("company")
  name      String   @default("")
  legalName String   @default("")
  taxId     String   @default("")
  address   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  website   String   @default("")
  updatedAt DateTime @updatedAt
}

/// A physical store location. taxRateBps is basis points (975 = 9.75%) and is
/// charged on every line of a sale rung by a cashier assigned to this store.
model Store {
  id         String   @id @default(cuid())
  name       String   @unique
  taxRateBps Int      @default(0)
  address    String   @default("")
  phone      String   @default("")
  email      String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users User[]
  sales Sale[]
}

/// Staff who can sign in. role is "MANAGER" or "CASHIER".
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("CASHIER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  sales          Sale[]
  shifts         Shift[]
  purchaseOrders PurchaseOrder[]

  @@index([storeId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

/// Supplier directory. Products carry the vendor name as a string (see
/// Product.vendor); this table holds the contact details for that name.
model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  contact   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  notes     String   @default("")
  // Order total (in cents) this vendor requires for free freight. 0 = none.
  // Ordering below this only warns; it never blocks the purchase order.
  freightMinimumCents Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Customer directory. Rows are created automatically the first time a sale is
/// invoiced to a customer name, and can be edited here afterward.
model Customer {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  company   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

/// A sellable item. All money is stored as integer cents. Sales tax is not set
/// per product — it comes from the cashier's Store (see Store.taxRateBps).
model Product {
  id          String  @id @default(cuid())
  name        String
  sku         String  @unique
  barcode     String? @unique
  description String?
  priceCents  Int
  costCents   Int     @default(0)
  // Unilateral minimum resale price, in cents. The item may never be sold
  // below this — after every discount — at the register. 0 = no floor.
  umrpCents   Int     @default(0)
  trackStock  Boolean @default(true)
  stock       Int     @default(0)
  active      Boolean @default(true)
  favorite    Boolean @default(false)
  vendor      String  @default("")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  saleItems SaleItem[]
  poItems   PurchaseOrderItem[]

  @@index([categoryId])
  @@index([active])
  @@index([favorite])
  @@index([vendor])
}

/// A completed (or voided) transaction. status is "COMPLETED" or "VOIDED".
/// paymentMethod is "CASH" or "CARD".
model Sale {
  id            String @id @default(cuid())
  number        Int    @unique
  status        String @default("COMPLETED")
  subtotalCents Int
  // Sum of catalog list price × qty, before any manual price change or
  // discount. Used to show the customer's saving vs. list. 0 on old rows.
  listSubtotalCents Int @default(0)
  discountCents Int    @default(0)
  taxCents      Int    @default(0)
  taxRateBps    Int    @default(0)
  totalCents    Int
  paymentMethod String
  tenderedCents Int    @default(0)
  changeCents   Int    @default(0)
  note          String?

  // Store the sale was rung at (the cashier's assigned store). storeId may be
  // null for historic rows; the snapshot freezes the name onto the invoice.
  storeId           String?
  store             Store?  @relation(fields: [storeId], references: [id])
  storeNameSnapshot String  @default("")

  // Customer the invoice is billed to. customerId may be null (walk-in);
  // the snapshot fields freeze the details onto this invoice.
  customerId              String?
  customer                Customer? @relation(fields: [customerId], references: [id])
  customerNameSnapshot    String    @default("")
  customerEmailSnapshot   String    @default("")
  customerPhoneSnapshot   String    @default("")
  customerAddressSnapshot String    @default("")

  cashierId String
  cashier   User   @relation(fields: [cashierId], references: [id])
  shiftId   String?
  shift     Shift?  @relation(fields: [shiftId], references: [id])

  createdAt DateTime        @default(now())
  items     SaleItem[]
  purchaseOrders PurchaseOrder[]

  @@index([createdAt])
  @@index([customerId])
  @@index([cashierId])
  @@index([storeId])
}

model SaleItem {
  id             String @id @default(cuid())
  nameSnapshot   String
  skuSnapshot    String @default("")
  vendorSnapshot String @default("")
  unitPriceCents Int
  unitCostCents  Int    @default(0)
  quantity       Int
  discountCents  Int    @default(0)
  taxRateBps     Int    @default(0)
  lineTotalCents Int

  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

/// A purchase order. Two ways it comes to exist:
///  - raised from a sale/invoice (saleId set; poNumber = invoice number + a
///    letter per vendor, e.g. "1042A"), or
///  - entered by hand on the PO form (saleId null; poNumber auto "CB-MMDDYY",
///    editable).
/// status: "OPEN" | "CLOSED" | "SENT" | "RECEIVED" | "CANCELLED".
/// subtotalCents = sum of every category line + item line amount.
model PurchaseOrder {
  id            String  @id @default(cuid())
  poNumber      String  @unique
  vendor        String
  status        String  @default("OPEN")
  subtotalCents Int     @default(0)
  note          String?

  // Header
  email          String  @default("")
  ccBcc          String  @default("")
  mailingAddress String  @default("")
  shipTo         String  @default("")
  shippingAddress String @default("")
  poDate         DateTime @default(now())
  dueDate        DateTime?
  shipVia        String  @default("")
  storeName      String  @default("")
  permitNumber   String  @default("")
  messageToCustomer String @default("")
  poRef          String  @default("")
  salesRep       String  @default("")
  mobileNumber   String  @default("")
  tags           String  @default("[]")

  // Footer
  messageToVendor String @default("")
  memo            String @default("")

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  items         PurchaseOrderItem[]
  categoryLines PurchaseOrderCategoryLine[]

  @@index([vendor])
  @@index([status])
}

/// "Item details" table row: a product/service being ordered.
model PurchaseOrderItem {
  id              String @id @default(cuid())
  nameSnapshot    String @default("")
  skuSnapshot     String @default("")
  description     String @default("")
  quantity        Int
  unitCostCents   Int
  lineCostCents   Int
  customerProject String @default("")
  klass           String @default("")
  sortOrder       Int    @default(0)

  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
}

/// "Category details" table row: an expense category, amount entered directly.
model PurchaseOrderCategoryLine {
  id              String @id @default(cuid())
  category        String @default("")
  description     String @default("")
  amountCents     Int    @default(0)
  customerProject String @default("")
  klass           String @default("")
  sortOrder       Int    @default(0)

  poId String
  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
}

/// A cashier's till session. status is "OPEN" or "CLOSED".
model Shift {
  id                String    @id @default(cuid())
  openingFloatCents Int       @default(0)
  closingCountCents Int?
  status            String    @default("OPEN")
  openedAt          DateTime  @default(now())
  closedAt          DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])
  sales  Sale[]

  @@index([userId])
  @@index([status])
}
