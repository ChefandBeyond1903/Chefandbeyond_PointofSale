// CB_POS — Retail point-of-sale
// Runs on Supabase Postgres. DATABASE_URL is the pooled (pgbouncer) connection;
// DIRECT_URL is the direct connection Prisma uses for db push / migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The operating company. A single row, id = "company". Its details appear on
/// receipts and invoices; individual locations live in Store.
model Company {
  id        String   @id @default("company")
  name      String   @default("")
  legalName String   @default("")
  taxId     String   @default("")
  address   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  website   String   @default("")
  updatedAt DateTime @updatedAt
}

/// A physical store location. taxRateBps is basis points (975 = 9.75%) and is
/// charged on every line of a sale rung by a cashier assigned to this store.
model Store {
  id         String   @id @default(cuid())
  name       String   @unique
  taxRateBps Int      @default(0)
  address    String   @default("")
  phone      String   @default("")
  email      String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users          User[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  inventory      StoreInventory[]
  bills          Bill[]
  expenses       Expense[]
}

/// Staff who can sign in. role is "CASHIER", "MANAGER" (scoped to one store),
/// or "ADMIN" (all stores, cross-store reports).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  // Supabase Auth user id (auth.users.id). Identity and passwords live in
  // Supabase; this row carries the POS role/store assignment.
  authId    String?  @unique
  role      String   @default("CASHIER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  // Who created this account. A cashier can only manage the staff they created.
  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedBy")

  sales          Sale[]          @relation("SaleCashier")
  salesCredited  Sale[]          @relation("SaleSalesperson")
  shifts         Shift[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]
  heldSales      HeldSale[]
  expenses       Expense[]

  @@index([storeId])
  @@index([createdById])
}

/// A parked / suspended sale. A salesperson builds a cart (often on a phone out
/// in the warehouse) and holds it instead of charging; it can then be recalled
/// on another device — e.g. a desktop in the office — and the sale finished.
model HeldSale {
  id                 String @id @default(cuid())
  label              String @default("")
  note               String @default("")
  orderDiscountCents Int    @default(0)
  shippingCents      Int    @default(0)

  storeId         String?
  salespersonId   String?
  customerId      String?
  customerName    String  @default("")
  customerEmail   String  @default("")
  customerPhone   String  @default("")
  customerAddress String  @default("")
  customerCompany String  @default("")

  /// [{ productId, quantity, unitPriceCents, discountCents }]
  items Json

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([createdById])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

/// Supplier directory. Products carry the vendor name as a string (see
/// Product.vendor); this table holds the contact details for that name.
model Vendor {
  id                  String   @id @default(cuid())
  name                String   @unique
  contact             String   @default("")
  email               String   @default("")
  phone               String   @default("")
  address             String   @default("")
  notes               String   @default("")
  // Order total (in cents) this vendor requires for free freight. 0 = none.
  // Ordering below this only warns; it never blocks the purchase order.
  freightMinimumCents Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Customer directory. Rows are created automatically the first time a sale is
/// invoiced to a customer name, and can be edited here afterward.
model Customer {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  company   String   @default("")
  notes     String   @default("")

  // Sales-tax exemption. When taxExempt is on (and not past taxExemptExpiresAt),
  // invoices to this customer ring at 0% tax. The certificate itself is stored
  // in a private Supabase Storage bucket; taxExemptDocPath is the object key.
  taxExempt           Boolean   @default(false)
  taxExemptCertNumber String    @default("")
  taxExemptState      String    @default("")
  taxExemptExpiresAt  DateTime?
  taxExemptDocPath    String    @default("")
  taxExemptDocName    String    @default("")

  // Default payment terms for this customer's invoices ("" = due on receipt).
  // "" | "Due on receipt" | "Net 15" | "Net 30" | "Net 45" | "Net 60".
  paymentTerms String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

/// A sellable item. All money is stored as integer cents. Sales tax is not set
/// per product — it comes from the cashier's Store (see Store.taxRateBps).
model Product {
  id          String  @id @default(cuid())
  name        String
  sku         String  @unique
  barcode     String? @unique
  description String?
  priceCents  Int
  costCents   Int     @default(0)
  // Unilateral minimum resale price, in cents. The item may never be sold
  // below this — after every discount — at the register. 0 = no floor.
  umrpCents   Int     @default(0)
  // Whether stock is counted at all. Quantities live per-store in StoreInventory.
  trackStock  Boolean @default(true)
  active      Boolean @default(true)
  favorite    Boolean @default(false)
  vendor      String  @default("")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  saleItems SaleItem[]
  poItems   PurchaseOrderItem[]
  inventory StoreInventory[]
  billItems BillItem[]

  @@index([categoryId])
  @@index([active])
  @@index([favorite])
  @@index([vendor])
  // Catalog and inventory both list products ordered by name; the composite
  // lets Postgres serve "active products, name order" straight from an index.
  @@index([name])
  @@index([active, name])
}

/// On-hand quantity of one product at one store. Rows are created on demand
/// (first receipt, sale, or manual adjustment) and may go negative (overselling
/// is allowed).
model StoreInventory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([productId, storeId])
  @@index([storeId])
}

/// A completed (or voided) transaction. status is "COMPLETED" or "VOIDED".
/// paymentMethod is "CASH" or "CARD".
model Sale {
  id                String  @id @default(cuid())
  number            Int     @unique
  status            String  @default("COMPLETED")
  subtotalCents     Int
  // Sum of catalog list price × qty, before any manual price change or
  // discount. Used to show the customer's saving vs. list. 0 on old rows.
  listSubtotalCents Int     @default(0)
  discountCents     Int     @default(0)
  taxCents          Int     @default(0)
  taxRateBps        Int     @default(0)
  // Flat shipping/delivery charge added to the invoice. Not taxed.
  shippingCents     Int     @default(0)
  totalCents        Int
  paymentMethod     String
  tenderedCents     Int     @default(0)
  changeCents       Int     @default(0)
  note              String?

  // Invoice payment terms, snapshotted from the customer at sale time, and the
  // due date they imply. dueDate is null for due-on-receipt / walk-in sales.
  termsSnapshot             String    @default("")
  dueDate                   DateTime?
  customerTaxExemptSnapshot Boolean   @default(false)

  // Store the sale was rung at (the cashier's assigned store). storeId may be
  // null for historic rows; the snapshots freeze the store's details onto the
  // invoice so it stays correct if the store is later edited.
  storeId              String?
  store                Store?  @relation(fields: [storeId], references: [id])
  storeNameSnapshot    String  @default("")
  storeAddressSnapshot String  @default("")
  storePhoneSnapshot   String  @default("")
  storeEmailSnapshot   String  @default("")

  // Customer the invoice is billed to. customerId may be null (walk-in);
  // the snapshot fields freeze the details onto this invoice.
  customerId              String?
  customer                Customer? @relation(fields: [customerId], references: [id])
  customerNameSnapshot    String    @default("")
  customerEmailSnapshot   String    @default("")
  customerPhoneSnapshot   String    @default("")
  customerAddressSnapshot String    @default("")

  // The operator who was signed in and rang the sale.
  cashierId     String
  cashier       User    @relation("SaleCashier", fields: [cashierId], references: [id])
  // The salesperson credited with the sale. Defaults to the cashier; the
  // operator can switch it at the register. Null on legacy rows (= cashier).
  salespersonId String?
  salesperson   User?   @relation("SaleSalesperson", fields: [salespersonId], references: [id])
  shiftId       String?
  shift         Shift?  @relation(fields: [shiftId], references: [id])

  createdAt      DateTime        @default(now())
  items          SaleItem[]
  purchaseOrders PurchaseOrder[]

  @@index([createdAt])
  @@index([customerId])
  @@index([cashierId])
  @@index([salespersonId])
  @@index([storeId])
}

model SaleItem {
  id             String @id @default(cuid())
  nameSnapshot   String
  skuSnapshot    String @default("")
  vendorSnapshot String @default("")
  unitPriceCents Int
  unitCostCents  Int    @default(0)
  quantity       Int
  discountCents  Int    @default(0)
  taxRateBps     Int    @default(0)
  lineTotalCents Int

  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

/// A purchase order. Two ways it comes to exist:
///  - raised from a sale/invoice (saleId set; poNumber = invoice number + a
///    letter per vendor, e.g. "1042A"), or
///  - entered by hand on the PO form (saleId null; poNumber auto "CB-MMDDYY",
///    editable).
/// status: "OPEN" | "CLOSED" | "SENT" | "RECEIVED" | "CANCELLED".
/// subtotalCents = sum of every category line + item line amount.
model PurchaseOrder {
  id            String  @id @default(cuid())
  poNumber      String  @unique
  vendor        String
  status        String  @default("OPEN")
  // subtotalCents = every item line amount + shippingCents.
  subtotalCents Int     @default(0)
  // Flat freight/shipping charge entered on the item-details section.
  shippingCents Int     @default(0)
  note          String?

  // Header
  email             String    @default("")
  ccBcc             String    @default("")
  mailingAddress    String    @default("")
  shipTo            String    @default("")
  shippingAddress   String    @default("")
  poDate            DateTime  @default(now())
  dueDate           DateTime?
  shipVia           String    @default("")
  storeName         String    @default("")
  permitNumber      String    @default("")
  messageToCustomer String    @default("")
  poRef             String    @default("")
  salesRep          String    @default("")
  mobileNumber      String    @default("")
  tags              String    @default("[]")

  // Footer
  messageToVendor String @default("")
  memo            String @default("")

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // The store this PO belongs to (the creator's store, or the sale's store when
  // raised from an invoice). Null on legacy rows.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  items         PurchaseOrderItem[]
  categoryLines PurchaseOrderCategoryLine[]
  bills         Bill[]

  @@index([vendor])
  @@index([status])
  @@index([storeId])
}

/// "Item details" table row: a product/service being ordered.
model PurchaseOrderItem {
  id               String @id @default(cuid())
  nameSnapshot     String @default("")
  skuSnapshot      String @default("")
  description      String @default("")
  quantity         Int
  // Units received so far against this line (supports partial / corrected receipts).
  receivedQuantity Int    @default(0)
  unitCostCents    Int
  lineCostCents    Int
  customerProject  String @default("")
  klass            String @default("")
  sortOrder        Int    @default(0)

  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])
  billItems BillItem[]

  @@index([poId])
  @@index([productId])
}

/// A vendor bill (accounts payable), usually created when receiving a PO.
/// A PO can have several bills against it (partial receipts).
/// status: "OPEN" | "PAID".
model Bill {
  id            String    @id @default(cuid())
  billNumber    String    @default("") // the vendor's own invoice number
  vendor        String
  billDate      DateTime  @default(now())
  dueDate       DateTime?
  terms         String    @default("") // "", "Due on receipt", "Net 15", ...
  memo          String    @default("")
  status        String    @default("OPEN")
  paidAt        DateTime?
  subtotalCents Int       @default(0)

  storeId String?
  store   Store?         @relation(fields: [storeId], references: [id])
  poId    String?
  po      PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       BillItem[]

  @@index([vendor])
  @@index([storeId])
  @@index([poId])
  @@index([status])
  @@index([dueDate])
}

model BillItem {
  id            String @id @default(cuid())
  nameSnapshot  String @default("")
  skuSnapshot   String @default("")
  quantity      Int
  unitCostCents Int
  lineCostCents Int

  billId    String
  bill      Bill               @relation(fields: [billId], references: [id], onDelete: Cascade)
  poItemId  String?
  poItem    PurchaseOrderItem? @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  productId String?
  product   Product?           @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([poItemId])
  @@index([productId])
}

/// An operating expense — rent, utilities, insurance, and the like. Not tied to
/// a purchase order or a product; recorded so the P&L can show net profit after
/// all costs.
model Expense {
  id          String   @id @default(cuid())
  category    String
  payee       String   @default("") // landlord, utility company, …
  amountCents Int
  expenseDate DateTime @default(now())
  memo        String   @default("")
  status      String   @default("PAID") // "PAID" | "UNPAID"

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([storeId])
  @@index([expenseDate])
  @@index([status])
}

/// A custom expense category added by a manager. The ready-made categories live
/// in code (lib/expenseCategories.ts); this table only holds the extras.
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

/// "Category details" table row: an expense category, amount entered directly.
model PurchaseOrderCategoryLine {
  id              String @id @default(cuid())
  category        String @default("")
  description     String @default("")
  amountCents     Int    @default(0)
  customerProject String @default("")
  klass           String @default("")
  sortOrder       Int    @default(0)

  poId String
  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
}

/// A cashier's till session. status is "OPEN" or "CLOSED".
model Shift {
  id                String    @id @default(cuid())
  openingFloatCents Int       @default(0)
  closingCountCents Int?
  status            String    @default("OPEN")
  openedAt          DateTime  @default(now())
  closedAt          DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])
  sales  Sale[]

  @@index([userId])
  @@index([status])
}
